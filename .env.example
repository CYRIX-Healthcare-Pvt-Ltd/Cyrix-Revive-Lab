# The same Supabase project as KPI — one sign-in, one employees table.
# Public values: both already ship inside every module's browser bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_AUTH_EMAIL_DOMAIN=cyrix.local
